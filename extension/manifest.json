{
  "manifest_version": 3,
  "name": "Terminal Checkout",
  "version": "1.5",
  "description": "GitHub PR·이슈·저장소 페이지에서 터미널(iTerm2/WezTerm)로 명령 실행",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://github.com/*/*"
      ],
      "js": [
        "defaults.js",
        "layout.js",
        "content.js"
      ]
    }
  ],
  "action": {},
  "options_page": "options.html"
}
