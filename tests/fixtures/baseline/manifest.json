{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "2.0.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*/*"
      ],
      "js": [
        "i18n.js",
        "_i18n/en.js",
        "_i18n/ko.js",
        "_i18n/ja.js",
        "_i18n/zh-Hans.js",
        "_i18n/zh-Hant.js",
        "defaults.js",
        "layout.js",
        "content.js"
      ]
    }
  ],
  "action": {},
  "options_page": "options.html"
}
